<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.rethinkj.updater</groupId>
    <artifactId>rethinkj-updater-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rethinkj-updater-helper</artifactId>

  <name>rethinkj Updater :: Helper</name>
  <description>The process that replaces an app's files once it has exited, and starts it again.</description>

  <!-- No dependencies at run time: it runs from a copy while the app's files are replaced. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.rethinkj.updater.helper.Helper</mainClass>
            </manifest>
            <manifestEntries>
              <!-- The plan formats Plan.read accepts, separated by spaces; core reads this. -->
              <Rethinkj-Updater-Plan-Formats>1</Rethinkj-Updater-Plan-Formats>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
